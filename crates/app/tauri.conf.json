{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ozma AI VPN Closer",
  "mainBinaryName": "ai-vpn-closer",
  "version": "0.1.3",
  "identifier": "ru.ozma.ai-vpn-closer",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:47613",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ozma AI VPN Closer",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Закрывает агентов, когда пропал VPN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
