{
  "name": "ozma-ai-vpn-closer-ui",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"e2e/**/*.ts\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"e2e/**/*.ts\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:guards": "vitest run src/guards.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/api": "2.12.5",
    "antd": "6.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.15.29",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "3.9.0",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.0.0",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.8.4",
    "sass-embedded": "1.97.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vite": "6.3.5",
    "vitest": "4.1.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "prettier --write"
    ]
  }
}
